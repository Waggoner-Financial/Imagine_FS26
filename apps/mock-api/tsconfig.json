{
  "extends": "../../tsconfig.options.json",
  "include": ["src/**/*.ts", "test/**/*.ts", "codegen.ts"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "allowJs": false,
    "checkJs": false,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "lib": ["ES2023"],
    "types": ["bun"],
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": ".",
    "tsBuildInfoFile": "tsconfig.tsbuildinfo",
    "resolveJsonModule": true
  },
  "references": [{ "path": "../../packages/mock-data" }]
}
